{
  "name": "zotero-cover-view",
  "type": "module",
  "version": "0.3.0-beta.1",
  "description": "View covers of books and documents directly in Zotero.",
  "config": {
    "addonName": "Cover View for Zotero",
    "addonID": "coverview@insature.net",
    "addonRef": "coverview",
    "addonInstance": "CoverView",
    "prefsPrefix": "extensions.zotero.coverview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulluis-roehl/zotero-cover-view.git"
  },
  "author": "Paul Luis Röhl",
  "bugs": {
    "url": "https://github.com/paulluis-roehl/zotero-cover-view/issues"
  },
  "homepage": "https://github.com/paulluis-roehl/zotero-cover-view#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.5.1",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "eslint": "^10.10.0",
    "mocha": "^12.0.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
